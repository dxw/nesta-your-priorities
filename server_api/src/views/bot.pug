//- Link-preview robots get this page instead of the SPA's index.html, so a
//- page with no description or image of its own falls back to the same
//- hard-coded values index.html carries. Without them, previews show the
//- platform footer below as the description.
- var shareDescription = descriptionText || "Martin Lewis wants your ideas for practical, small, non-controversial ways to improve the UK."
- var shareImageUrl = imageUrl || "https://small-ideas.org/images/home/og-image.png"
doctype html
html(lang="en")
    head
        title= title
        meta(name="description" content= shareDescription)
        meta(property="og:url" content= url)
        meta(property="og:title" content= title)
        meta(property="og:description" content= shareDescription)
        meta(property="og:image" content= shareImageUrl)
        meta(property="og:type" content="website")
        meta(property="og:image:width" content="1200")
        meta(property="og:image:height" content="630")
        meta(name="twitter:card" content="summary_large_image")
        meta(name="twitter:url" content= url)
        meta(name="twitter:title" content= title)
        meta(name="twitter:description" content= shareDescription)
        meta(name="twitter:image" content= shareImageUrl)
        meta(name="twitter:image:alt" content= title)

    body
        h1= title
        img(src= shareImageUrl alt= title)
        p= shareDescription
        if staticHtml
            div
                != staticHtml
        else
            div
                h2= subItemContainerName
                each val in subItemIds
                    div
                        a(href != subItemsUrlbase+val.id)
                            p
                                != val.name
            div
                each val in subItemPoints
                    div
                        p= val.content
        if moreUrl
            p
                b
                    a(href != moreUrl)
                        div
                            p= moreText
        p
            b
                a(href != backUrl)
                    div
                        p= backText
        p
            small
                = "This content is created by the open source Your Priorities citizen engagement platform designed by the non profit Citizens Foundation"
        p
            small
                a(href != "https://github.com/CitizensFoundation/your-priorities-app")
                    div
                        = "Your Priorities on GitHub"
        p
            small
                a(href != "https://citizens.is")
                    div
                        = "Check out the Citizens Foundation website for more information"





